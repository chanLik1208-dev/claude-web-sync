{
  "manifest_version": 3,
  "name": "Claude Web Sync",
  "version": "0.1.0",
  "description": "Periodically save your claude.ai custom instructions, memory, Projects and Styles to local files.",
  "permissions": ["alarms", "storage", "unlimitedStorage", "downloads", "scripting", "webRequest"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Claude Web Sync", "default_popup": "popup.html" }
}
